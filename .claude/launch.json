{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@latentpresence/web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@latentpresence/web",
        "exec",
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@latentpresence/web",
        "exec",
        "vite",
        "../../../latentpresence.com",
        "--port",
        "4321",
        "--strictPort"
      ],
      "port": 4321
    },
    {
      "name": "companion",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "companion"
      ],
      "port": 8787
    },
    {
      "name": "companion-check",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "companion"
      ],
      "env": {
        "COMPANION_PORT": "8799"
      },
      "port": 8799,
      "autoPort": false
    }
  ]
}
