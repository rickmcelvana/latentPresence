# Copy to .env and fill in. .env is gitignored and never committed (CLAUDE.md hard rule).

# Memory store (ADR-17). Development uses the MariaDB 11.8+ on the remote Linux
# box over the tunnel; CI uses the service container in companion/dev/.
DATABASE_URL=mysql://latentpresence:CHANGE_ME@10.0.0.1:3306/latentpresence

# Address the Rust companion binds. The web app talks to it at http://127.0.0.1:$COMPANION_PORT.
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8787

# Deploy targets for scripts/deploy.sh (P0-T03). The repo is public, so the server
# lives here and never in the script. Dry run is the default; --live writes.
DEPLOY_HOST=user@host
DEPLOY_SITE_PATH=/var/www/latentpresence.com
DEPLOY_APP_PATH=/var/www/app.latentpresence.com
