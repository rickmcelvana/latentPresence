# Copy to .env and fill in. .env is gitignored and never committed (CLAUDE.md hard rule).

# Memory store (ADR-17). Development uses the MariaDB 11.8+ on the remote Linux
# box over the tunnel; CI uses the service container in companion/dev/.
DATABASE_URL=mysql://latentpresence:CHANGE_ME@10.0.0.1:3306/latentpresence

# Address the Rust companion binds. The web app talks to it at http://127.0.0.1:$COMPANION_PORT.
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8787

# ---------------------------------------------------------------------------
# Live provider checks (docs/TASKS.md). Optional: absent keys are skipped, not
# failed. Nothing here is read by the app — only by the hand-run live harness,
# which is never part of `pnpm gate`.
# ---------------------------------------------------------------------------

# Ollama needs no key. Change only if it is not on this box.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Native adapters (P1-T03). These names are the ones the AI SDK itself reads.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI-compatible presets (P1-T02).
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=

# QwenCloud. Worth having because it is the only way to exercise a *custom base
# URL* on the native adapters live — a config path with no live coverage today.
# Fill in whichever of the two your account exposes.
QWEN_API_KEY=
QWEN_OPENAI_BASE_URL=
QWEN_ANTHROPIC_BASE_URL=

# Text to speech (P1-T05). Anything speaking POST /v1/audio/speech: OpenAI
# itself, or a local Kokoro-FastAPI at http://127.0.0.1:8880/v1 (no key).
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
