# Executors must not decide line endings (lesson from latentCreate T-002).
* text=auto eol=lf

# Large approved assets go through LFS. Model weights are never committed at all (.gitignore).
*.vrm filter=lfs diff=lfs merge=lfs -text
*.vrma filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text

# Favicons are under 30 KB. LFS is here to keep character renders out of the repo,
# not icons, and a site that needs `git lfs pull` before it can be served is worse.
# `binary` unsets diff, merge and text together: never run eol conversion on a PNG.
site/img/*.png -filter binary

# Tauri's scaffold icons (P0-T08), for the same reason and one more. Small; needed at
# build time on every machine that compiles the shell; and PROJECT.md records that a plain
# `git pull && pnpm install` is enough to work here — putting the first real LFS payload in
# the repo to carry twelve 32 KB PNGs would quietly make that false, on the Windows box
# that has to run this next. `binary` also stops eol conversion ever touching the .ico and
# .icns, which `text=auto` above leaves to a heuristic.
apps/desktop/src-tauri/icons/* -filter binary
