# Executors must not decide line endings (lesson from latentCreate T-002).
* text=auto eol=lf

# Large approved assets go through LFS. Model weights are never committed at all (.gitignore).
*.vrm filter=lfs diff=lfs merge=lfs -text
*.vrma filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text

# Favicons are 1-20 KB each. LFS is here to keep character renders out of the repo,
# not icons, and a site that needs `git lfs pull` before it can be served is worse.
site/img/*.png -filter -diff -merge text=auto
