# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# typescript incremental build state
*.tsbuildinfo
.tsbuild/

# test and tooling output
coverage/
playwright-report/
test-results/

# Live-check output — real audio, regenerated on demand, never committed
packages/providers/live/out/
packages/ml-web/live/out/

# Recordings from human runs (R-11's videos): tens of MB each, analysed into docs/runs/,
# kept locally for re-analysis and never committed
docs/runs/media/

# Downloaded animation packs (R-12): only the retargeted .vrma and the manifest are committed
assets/clips/source/
