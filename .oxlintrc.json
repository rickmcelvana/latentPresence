{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["**/dist/**", "**/target/**", "**/node_modules/**"],
  "overrides": [
    {
      // Worker.postMessage has no targetOrigin parameter -- its second argument is the
      // transfer list, so "insert self.location.origin" would send the origin string as
      // a transferable. The rule cannot tell a Worker from a window; these files only
      // ever post to workers.
      "files": ["apps/web/src/spikes/**"],
      "rules": { "unicorn/require-post-message-target-origin": "off" }
    }
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    // `_hp` is the feedback API's honeypot field. The name is fixed by that service's
    // deserialiser (docs/SURFACE.md), so renaming it to satisfy a style rule would
    // silently break every report the form sends.
    "eslint/no-underscore-dangle": ["error", { "allow": ["_hp"] }],
    // React 19 automatic JSX runtime: React is not imported for JSX (ADR-11 toolchain).
    "react/react-in-jsx-scope": "off"
  }
}
