{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "onnxruntime-web": ["./node_modules/onnxruntime-web/types.d.ts"]
    },
    // P9-T02: `vite.config.ts` imports the budgets by their real file names, which Vite's
    // native config loader will require (it warns on every build and test run without them).
    "allowImportingTsExtensions": true,
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": ["src", "vite.config.ts"],
  "references": [
    { "path": "../../packages/protocol" },
    { "path": "../../packages/core" },
    { "path": "../../packages/providers" },
    { "path": "../../packages/avatar" },
    { "path": "../../packages/ml-web" }
  ]
}
