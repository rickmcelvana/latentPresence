{
  "name": "latentpresence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gate": "pnpm run gate:app && pnpm run gate:rust",
    "gate:app": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "gate:rust": "pnpm run rust:fmt && pnpm run rust:clippy && pnpm run rust:test",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "build": "pnpm --filter @latentpresence/web run build",
    "dev": "pnpm --filter @latentpresence/web run dev",
    "rust:fmt": "cargo fmt --manifest-path companion/Cargo.toml --all --check",
    "rust:clippy": "cargo clippy --manifest-path companion/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path companion/Cargo.toml --workspace",
    "gate:desktop": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "live:llm": "pnpm --filter @latentpresence/providers exec vite-node live/llm.ts",
    "live:tts": "pnpm --filter @latentpresence/providers exec vite-node live/tts.ts",
    "live:kokoro": "pnpm --filter @latentpresence/ml-web exec vite-node live/kokoro-dtype.ts",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
