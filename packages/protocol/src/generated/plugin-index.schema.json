{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "number",
      "const": 1
    },
    "plugins": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,23}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
          },
          "licence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "tags": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          },
          "manifest": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "files": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(\\/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "author",
          "version",
          "licence",
          "manifest",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "plugins"
  ],
  "additionalProperties": false,
  "title": "latentPresence plugin index",
  "description": "plugins/index.json, format 1 (ADR-72 item 9). Written by `pnpm plugin:index`."
}
