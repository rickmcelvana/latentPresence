{
  "$schema": "../../packages/protocol/src/generated/plugin.schema.json",
  "format": 1,
  "id": "tarot",
  "name": "Tarot",
  "version": "0.2.0",
  "author": "Rick McElvana",
  "licence": "Apache-2.0",
  "homepage": "https://github.com/rickmcelvana/latentPresence/tree/main/plugins/tarot",
  "summary": "Draws tarot cards from a full 78-card deck and lays them out on the wall; use it when someone asks for a reading.",
  "minApp": "1.0.0",
  "instructions": "instructions.md",
  "data": {
    "cards": "data/cards.json",
    "spreads": "data/spreads.json"
  },
  "tools": [
    {
      "name": "draw_spread",
      "description": "Shuffles the deck, draws the cards for a spread, and lays them out on the wall. Returns the spread and each card with its position, whether it came up reversed, and its upright and reversed meanings.",
      "parameters": {
        "spread": {
          "type": "string",
          "description": "Which spread to lay out: one card, three cards (past, present, future) or the Celtic cross.",
          "enumFrom": {
            "table": "spreads",
            "column": "id"
          },
          "required": true
        }
      },
      "steps": [
        {
          "use": "lookup",
          "as": "spread",
          "table": "spreads",
          "key": "$args.spread"
        },
        {
          "use": "draw",
          "as": "cards",
          "table": "cards",
          "slots": "$spread.positions",
          "reversed": "$settings.reversals"
        },
        {
          "use": "show",
          "board": "spread",
          "items": "$cards",
          "title": "$spread.name"
        }
      ],
      "returns": [
        "spread",
        "cards"
      ]
    }
  ],
  "boards": {
    "spread": {
      "layout": "cards",
      "image": "image",
      "flip": "reversed",
      "caption": "{{slot}}: {{name}}"
    }
  },
  "settings": {
    "reversals": {
      "type": "switch",
      "label": "Cards can come up reversed",
      "default": true
    }
  },
